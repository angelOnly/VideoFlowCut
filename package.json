{
  "name": "video-cut",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,worker,render,web -c cyan,magenta,green,yellow \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:render-worker\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:worker": "tsx watch apps/job-worker/src/index.ts",
    "dev:render-worker": "tsx watch apps/render-worker/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx apps/server/src/index.ts",
    "worker": "tsx apps/job-worker/src/index.ts",
    "render-worker": "tsx apps/render-worker/src/index.ts",
    "runtime": "tsx apps/runtime/src/index.ts",
    "mcp": "tsx apps/server/src/mcp.ts",
    "plugin:sync-skills": "node plugins/videoflowcut/scripts/sync-skills.mjs",
    "plugin:build": "npm run typecheck && npm run build:web && npm run plugin:sync-skills && node plugins/videoflowcut/scripts/build-runtime.mjs && node plugins/videoflowcut/scripts/configure-repo.mjs",
    "plugin:build-runtime": "node plugins/videoflowcut/scripts/build-runtime.mjs",
    "plugin:verify": "node plugins/videoflowcut/scripts/verify-plugin.mjs",
    "plugin:e2e": "node plugins/videoflowcut/scripts/plugin-e2e.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "test:effect-registry": "tsx scripts/effect-registry-smoke.e2e.ts",
    "test:creative-eval": "tsx scripts/presenter-creative-agent.eval.ts",
    "test:stage1-live": "tsx scripts/presenter-stage1-live.e2e.ts",
    "test:stage1-full-live": "tsx scripts/presenter-stage1-live.e2e.ts --full",
    "test:stage3-explainer": "tsx scripts/explainer-stage3.e2e.ts",
    "test:stage3-explainer-full": "tsx scripts/explainer-stage3.e2e.ts --full",
    "test:stage3-delivery": "tsx scripts/explainer-stage3-delivery.e2e.ts",
    "test:stage4-vlog": "tsx scripts/vlog-stage4.e2e.ts",
    "test:e2e": "npm run test:effect-registry"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@remotion/bundler": "4.0.519",
    "@remotion/player": "4.0.519",
    "@remotion/renderer": "4.0.519",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.519",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
