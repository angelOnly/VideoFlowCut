      "scriptRevision": 1,
      "basis": "confirmed_script"
    }
  },
  {
    "token_start_index": 45,
    "token_end_index": 61,
    "text": "让离 AI 最近的人，开始担心它跑得太快？",
    "startFrame": 228,
    "endFrame": 298,
    "source_text_review": {
      "speechSegmentIds": [
