  "name": "机器人进厂 · 可靠性与工位",
  "source": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><title>机器人进厂 · 可靠性与工位</title>\n<style>\n:root{--ink:#101113;--paper:#f4f2ed;--red:#df1235;--line:4px;--display:176px;--heading:88px;--body:48px}\n*{box-sizing:border-box}html,body{margin:0;width:1920px;height:1080px;overflow:hidden;background:var(--ink)}body{font-family:var(--vfc-font-title);color:var(--paper)}\n#robot-reliability{position:relative;width:1920px;height:1080px;overflow:hidden;background:var(--ink);isolation:isolate}.scene{position:absolute;inset:0;overflow:hidden;visibility:hidden}.type{position:absolute;margin:0;line-height:1.06;letter-spacing:-.045em;font-weight:inherit;white-space:nowrap}.display{font-family:var(--vfc-font-display);font-size:var(--display)}.heading{font-size:var(--heading)}.body{font-size:var(--body)}.media{position:absolute;overflow:hidden;background:var(--ink);transform-origin:50% 50%}.media img{display:block;width:100%;height:100%;object-fit:cover}.frame{border:var(--line) solid var(--paper)}.red{color:var(--red)}.paper{background:var(--paper);color:var(--ink)}.stripe{position:absolute;background:var(--red);height:112px;width:2400px;display:flex;align-items:center;gap:96px;padding-left:96px;font-size:64px;white-space:nowrap;letter-spacing:.02em}\n#probability{background:var(--ink)}#prob-back{position:absolute;inset:0;background:var(--paper);opacity:0}#prob-media{left:0;top:0;width:1920px;height:1080px;z-index:1}#prob-car{position:absolute;inset:0;opacity:0}#prob-vignette{position:absolute;inset:0;background:linear-gradient(90deg,#000b,transparent 65%)}#dots{position:absolute;inset:0;width:1920px;height:1080px;z-index:3}\n#single{left:96px;top:104px;z-index:4}#single-number{display:block;font-size:240px;line-height:.95}#single-label{display:block;font-size:64px;line-height:1.4;letter-spacing:0}#independent{left:104px;top:928px;font-size:44px;z-index:4;letter-spacing:.06em}#independent span{display:block}#all-success{left:104px;top:128px;font-size:64px;z-index:4}#formula{left:104px;top:864px;font-size:44px;z-index:4;letter-spacing:0}#formula sup{font-size:28px}#approx{left:104px;top:764px;font-size:56px;z-index:4}#prob-rule{position:absolute;left:96px;top:456px;width:664px;height:4px;background:var(--red);z-index:4;transform-origin:left}#prob-scan{position:absolute;left:110px;top:455px;width:8px;height:430px;background:var(--red);z-index:5}\n#exception{background:var(--paper);color:var(--ink)}#exception-surround{position:absolute;inset:0}#exception-surround .type:nth-child(1){left:96px;top:100px;font-size:144px}#exception-surround .type:nth-child(2){right:96px;top:820px;font-size:112px}#exception-media{left:480px;top:290px;width:960px;height:540px;border:4px solid var(--ink);z-index:2;transform:translateY(600px) rotate(-13deg)}#atlas-picture{position:absolute;inset:0;overflow:hidden}.source-plate{position:absolute;inset:0;transform:scale(1.29);transform-origin:50% 0}.source-plate.atlas-crop{transform:scale(1.21)}#digit-near .source-plate{transform-origin:100% 0}#scan-band{position:absolute;left:0;top:0;width:100%;height:40px;background:var(--red);mix-blend-mode:multiply;z-index:4;opacity:0}#decision{position:absolute;left:736px;top:324px;width:448px;height:448px;border-radius:50%;background:var(--red);color:var(--paper);display:flex;align-items:center;justify-content:center;font-size:88px;z-index:5;transform:scale(0)}\n#branches{position:absolute;inset:0;z-index:5}#branch-lines{position:absolute;inset:0;width:1920px;height:1080px;fill:none;stroke:var(--ink);stroke-width:6}#branch-lines path{stroke-dasharray:1400;stroke-dashoffset:1400}.branch{position:absolute;top:400px;width:600px;text-align:center}.branch .heading,.branch .body{position:relative;display:block}.branch .body{margin-top:24px}.branch:first-of-type{left:200px}.branch:nth-of-type(2){left:1120px}#rejoin{left:720px;top:832px;font-size:80px}#human-window{left:96px;top:420px;width:768px;height:432px;z-index:6}#conveyor-window{left:1056px;top:420px;width:768px;height:432px;z-index:6}#human-label{left:96px;top:260px;z-index:6;font-size:88px}#queue-label{left:1056px;top:260px;z-index:6;font-size:88px}#waiting-thread{position:absolute;left:780px;top:948px;width:1040px;height:8px;background:var(--red);transform-origin:left;z-index:6}\n#collection{background:var(--ink)}#collection-car{left:96px;top:240px;width:1040px;height:585px;z-index:2}#collection-yellow{left:1168px;top:96px;width:656px;height:369px;z-index:3}#collection-pallet{position:absolute;inset:0;opacity:0}#collection-operator{left:1168px;top:600px;width:656px;height:369px;z-index:3}#collection-title{left:96px;top:80px;font-size:112px;z-index:4}#ribbon-stable{left:-180px;top:400px;transform:rotate(-9deg);z-index:5;color:var(--paper)}#ribbon-human{left:-180px;top:710px;transform:rotate(8deg);z-index:6;background:var(--paper);color:var(--ink)}#collection-spine{position:absolute;left:1152px;top:80px;width:8px;height:920px;background:var(--red);transform-origin:top;z-index:1}\n#question{background:var(--ink)}#question-car{left:0;top:0;width:1920px;height:1080px}#question-shade{position:absolute;inset:0;background:linear-gradient(90deg,#101113dd,transparent 80%)}#question-why{left:96px;top:112px;font-size:96px;z-index:3}#question-arm{left:96px;top:320px;font-size:232px;z-index:3}#question-already{left:112px;top:784px;font-size:80px;z-index:3}#question-line{position:absolute;left:0;top:660px;width:1920px;height:16px;background:var(--red);transform-origin:left;z-index:4}\n#workstation{background:var(--paper);color:var(--ink);perspective:1800px}#station-yellow{left:0;top:240px;width:1344px;height:756px;z-index:3}#station-pallet{left:96px;top:256px;width:1200px;height:675px;z-index:2}#station-conveyor{left:512px;top:268px;width:1312px;height:738px;z-index:1}#station-fixed{left:1120px;top:96px;font-size:208px;z-index:4}#station-task{left:1376px;top:556px;font-size:80px;z-index:4;line-height:1.24}#station-task span{display:block}#station-flow{left:96px;top:88px;font-size:136px;z-index:5}#station-flow-detail{left:1360px;top:320px;font-size:64px;line-height:1.4;z-index:4}#station-flow-detail span{display:block}#station-fast{left:96px;top:96px;font-size:168px;z-index:5}#station-fast span{display:block}#rear-thread,#front-thread{position:absolute;inset:0;width:1920px;height:1080px;fill:none;stroke:var(--red);stroke-width:12}#rear-thread{z-index:0}#front-thread{z-index:5;pointer-events:none}#rear-thread path,#front-thread path{stroke-dasharray:3600;stroke-dashoffset:3600}\n#curl-cover{position:absolute;left:2040px;top:-120px;width:2240px;height:1320px;z-index:8;background:var(--paper);transform:rotate(-8deg);transform-origin:0 50%;box-shadow:-32px 0 64px #0005}#curl-fold{position:absolute;left:0;top:0;width:280px;height:100%;border-radius:50% 0 0 50%;background:linear-gradient(90deg,#777875,#f4f2ed 23%,#fff 48%,#c4c3bf 76%,#101113 100%);box-shadow:-16px 0 24px #0006;transform:rotateY(-44deg);transform-origin:right center}#curl-red{position:absolute;left:256px;top:0;width:20px;height:100%;background:var(--red)}\n#possibility{background:var(--ink)}#digit-near{left:0;top:0;width:1920px;height:1080px;z-index:1}#figure-work{left:1008px;top:112px;width:816px;height:459px;z-index:3}#digit-wide{left:96px;top:560px;width:800px;height:450px;z-index:2}#atlas-final{left:1008px;top:560px;width:816px;height:459px;z-index:3}#opportunity{left:96px;top:96px;font-size:224px;z-index:4}#reuse-world{left:96px;top:104px;font-size:88px;z-index:4;line-height:1.22}#reuse-world span{display:block}#today{left:96px;top:456px;font-size:64px;z-index:4}#tomorrow{left:1008px;top:628px;font-size:64px;z-index:4}#future{left:96px;top:96px;font-size:176px;z-index:5}#future-detail{left:104px;top:320px;font-size:72px;z-index:5;line-height:1.25}#future-detail span{display:block}#future-stroke{position:absolute;left:96px;top:508px;width:1728px;height:8px;background:var(--red);transform-origin:left;z-index:5}#possibility-rear{position:absolute;inset:0;stroke:var(--red);stroke-width:12;fill:none;z-index:0}#possibility-rear path{stroke-dasharray:3000;stroke-dashoffset:3000}\n#prob-scan{left:96px;top:356px;height:624px}#prob-rule{width:1728px}#single-number{font-size:224px}#all-success{left:96px;top:96px;font-size:96px}#formula{left:96px;top:248px;font-size:56px}#approx{left:1080px;top:780px;font-size:64px}#independent{top:888px}#prob-vignette{background:linear-gradient(180deg,#101113d9,transparent 56%,#10111399)}\n#exception-rear{position:absolute;inset:-40px;filter:blur(24px);opacity:0;overflow:hidden}#exception-rear img{width:100%;height:100%;object-fit:cover}#exception-surround{z-index:1}#exception-surround .type:nth-child(1){font-size:128px}#exception-surround .type:nth-child(2){font-size:96px}#human-window{left:1056px;top:416px}#conveyor-window{left:96px;top:416px}#automatic,#human{top:288px;z-index:7}#automatic{left:160px}#human{left:1160px}#branch-lines{z-index:8}#branch-lines circle{fill:var(--red);stroke:none}#waiting-thread{left:96px;top:904px;width:1728px}#decision{z-index:9}\n</style></head><body>\n<main id=\"robot-reliability\" data-composition-id=\"robot-reliability\" data-start=\"0\" data-duration=\"48.766666666666666\" data-width=\"1920\" data-height=\"1080\" data-fps=\"30\">\n<section id=\"probability\" class=\"scene\" aria-label=\"单次成功与连续全部成功的数学关系\"><div id=\"prob-back\"></div><div id=\"prob-media\" class=\"media\"><img id=\"yellow-opening\" data-vfc-video-slot=\"yellowOpening\" alt=\"黄机械臂持续抓取蓝色物件\"><div id=\"prob-car\"><img id=\"car-probability\" data-vfc-video-slot=\"carProbability\" alt=\"另一工厂的车身与机械臂\"></div><div id=\"prob-vignette\"></div></div><canvas id=\"dots\" width=\"1920\" height=\"1080\" aria-label=\"装饰点群聚为约百分之三十七，并非工厂统计\"></canvas><h1 id=\"single\" class=\"type\"><span id=\"single-number\">99<span style=\"font-size:.58em\">%</span></span><span id=\"single-label\">单次成功</span></h1><p id=\"independent\" class=\"type\"><span>假设</span><span>每次结果互不影响</span></p><div id=\"prob-rule\"></div><div id=\"prob-scan\"></div><h2 id=\"all-success\" class=\"type\">100次 · 全部成功</h2><p id=\"approx\" class=\"type\">大约只有</p><p id=\"formula\" class=\"type\">0.99<sup>100</sup> = 36.6032%</p></section>\n<section id=\"exception\" class=\"scene\" aria-label=\"异常处理抽象分支与独立生产素材\"><div id=\"exception-rear\"><div class=\"source-plate atlas-crop\"><img id=\"atlas-rear-video\" data-vfc-video-slot=\"atlasContinuous\" alt=\"同一Atlas活动画面的退虚背景\"></div></div><div id=\"exception-surround\"><p class=\"type\">对位 · 调整</p><p class=\"type\">持续动作</p></div><div id=\"exception-media\" class=\"media\"><div id=\"atlas-picture\"><div class=\"source-plate atlas-crop\"><img id=\"atlas-continuous\" data-vfc-video-slot=\"atlasContinuous\" alt=\"Atlas持件靠近、对位与调整，不标注真实故障或恢复\"></div></div><div id=\"scan-band\"></div></div><div id=\"decision\">分流</div><div id=\"branches\"><svg id=\"branch-lines\" viewBox=\"0 0 1920 1080\" aria-hidden=\"true\"><path id=\"branch-left\" d=\"M960 250 V320 H500 V388 M500 600 V744 Q500 784 540 784 H960 V824\"/><path id=\"branch-right\" d=\"M960 320 H1420 V388 M1420 600 V744 Q1420 784 1380 784 H960\"/><circle id=\"automatic-pulse\" cx=\"960\" cy=\"250\" r=\"18\"/><circle id=\"human-pulse\" cx=\"960\" cy=\"250\" r=\"18\"/></svg><div id=\"automatic\" class=\"branch\"><span class=\"heading\">自动恢复</span></div><div id=\"human\" class=\"branch\"><span class=\"heading\">人工处理</span></div></div><div id=\"human-window\" class=\"media\"><img id=\"operator-exception\" data-vfc-video-slot=\"operatorException\" alt=\"独立来源的人员操作控制器\"></div><div id=\"conveyor-window\" class=\"media\"><img id=\"conveyor-exception\" data-vfc-video-slot=\"conveyorException\" alt=\"独立来源的人员与输送线\"></div><div id=\"waiting-thread\"></div></section>\n<section id=\"collection\" class=\"scene\" aria-label=\"不同工厂的独立画面集合\"><div id=\"collection-spine\"></div><h2 id=\"collection-title\" class=\"type\">工厂要的，不只一次成功</h2><div id=\"collection-car\" class=\"media frame\"><img id=\"car-collection\" data-vfc-video-slot=\"carCollection\" alt=\"车身与蓝机械臂持续作业\"></div><div id=\"collection-yellow\" class=\"media frame\"><img id=\"yellow-collection\" data-vfc-video-slot=\"yellowCollection\" alt=\"黄机械臂移动蓝色物件\"><div id=\"collection-pallet\"><img id=\"pallet-collection\" data-vfc-video-slot=\"palletCollection\" alt=\"另一来源的托盘搬运\"></div></div><div id=\"collection-operator\" class=\"media frame\"><img id=\"operator-collection\" data-vfc-video-slot=\"operatorCollection\" alt=\"人员操作控制器\"></div><div id=\"ribbon-stable\" class=\"stripe\"><span>长时间 · 稳定工作</span><span>长时间 · 稳定工作</span><span>长时间 · 稳定工作</span></div><div id=\"ribbon-human\" class=\"stripe\"><span>处理问题 / 人员参与</span><span>处理问题 / 人员参与</span><span>处理问题 / 人员参与</span></div></section>\n<section id=\"question\" class=\"scene\" aria-label=\"为什么机械臂早已进入工厂\"><div id=\"question-car\" class=\"media\"><img id=\"car-question\" data-vfc-video-slot=\"carQuestion\" alt=\"车厂里的机械臂和车身持续运动\"><div id=\"question-shade\"></div></div><p id=\"question-why\" class=\"type\">那为什么</p><h2 id=\"question-arm\" class=\"type display\">机械臂</h2><p id=\"question-already\" class=\"type\">早就在工厂上班了？</p><div id=\"question-line\"></div></section>\n<section id=\"workstation\" class=\"scene\" aria-label=\"不同生产来源的固定工位与流程接力\"><svg id=\"rear-thread\" viewBox=\"0 0 1920 1080\" aria-hidden=\"true\"><path d=\"M-80 640 C400 640 120 48 700 128 S1610 60 1740 332 S1650 1020 2010 900\"/></svg><div id=\"station-conveyor\" class=\"media\"><img id=\"conveyor-station\" data-vfc-video-slot=\"conveyorStation\" alt=\"人员、料箱与输送线\"></div><div id=\"station-pallet\" class=\"media\"><img id=\"pallet-station\" data-vfc-video-slot=\"palletStation\" alt=\"托盘机械臂提升、转动与放置\"></div><div id=\"station-yellow\" class=\"media\"><img id=\"yellow-station\" data-vfc-video-slot=\"yellowStation\" alt=\"黄机械臂抓取物件\"></div><h2 id=\"station-fixed\" class=\"type display\">固定</h2><p id=\"station-task\" class=\"type\"><span>围绕</span><span>一个任务</span></p><h2 id=\"station-flow\" class=\"type\">流程，设计好</h2><p id=\"station-flow-detail\" class=\"type\"><span>怎么放</span><span>怎么接</span><span>下一步</span></p><h2 id=\"station-fast\" class=\"type display\"><span>又快</span><span class=\"red\">又稳</span></h2><svg id=\"front-thread\" viewBox=\"0 0 1920 1080\" aria-hidden=\"true\"><path d=\"M-80 880 C440 880 390 1040 900 992 S1580 820 1980 892\"/></svg><div id=\"curl-cover\"><div id=\"curl-fold\"></div><div id=\"curl-red\"></div></div></section>\n<section id=\"possibility\" class=\"scene\" aria-label=\"不同人形机器人素材与未来可能性\"><svg id=\"possibility-rear\" viewBox=\"0 0 1920 1080\" aria-hidden=\"true\"><path d=\"M-60 840 Q440 80 960 400 T1980 260\"/></svg><div id=\"digit-near\" class=\"media clean-bottom\"><div class=\"source-plate\"><img id=\"digit-near-video\" data-vfc-video-slot=\"digitNear\" alt=\"Digit与料箱的近景动作\"></div></div><div id=\"figure-work\" class=\"media clean-bottom frame\"><img id=\"figure-video\" data-vfc-video-slot=\"figureWork\" alt=\"另一机器人Figure的手部与工件动作\"></div><div id=\"digit-wide\" class=\"media clean-bottom frame\"><div class=\"source-plate\"><img id=\"digit-wide-video\" data-vfc-video-slot=\"digitWide\" alt=\"Digit全身与料箱动作\"></div></div><div id=\"atlas-final\" class=\"media frame\"><div class=\"source-plate atlas-crop\"><img id=\"atlas-final-video\" data-vfc-video-slot=\"atlasFinal\" alt=\"Atlas持件对位与调整\"></div></div><h2 id=\"opportunity\" class=\"type display\">机会</h2><p id=\"reuse-world\" class=\"type\"><span>人的通道</span><span>工具 · 设备</span></p><p id=\"today\" class=\"type\">今天搬料</p><p id=\"tomorrow\" class=\"type\">明天换个工位</p><h2 id=\"future\" class=\"type display\">未来，也许</h2><p id=\"future-detail\" class=\"type\"><span>不用为每项工作</span><span>重搭一套设备</span></p><div id=\"future-stroke\"></div></section>\n</main>\n<script>\n(() => {\nconst FPS=30, TOTAL=1463, rootId='robot-reliability';\nconst seconds=frame=>frame/FPS;\nconst fontTitle=window.vfc.fonts.title, fontDisplay=window.vfc.fonts.display;\ndocument.body.style.fontWeight=fontTitle.weight;document.body.style.fontStyle=fontTitle.style;\ndocument.querySelectorAll('.display').forEach(element=