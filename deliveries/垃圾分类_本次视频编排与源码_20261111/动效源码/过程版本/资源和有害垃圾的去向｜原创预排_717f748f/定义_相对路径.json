22 478c22-43 59-64 103-66-21 49-52 80-96 85z\" fill=\"#e4ecd9\"/>\n <path d=\"M960 598v100 M960 646H442v54 M960 646h518v54\" fill=\"none\" stroke=\"#8ca69a\" stroke-width=\"8\"/>\n <g id=\"resultA\">\n  <rect x=\"183\" y=\"702\" width=\"516\" height=\"110\" rx=\"12\" fill=\"#d4e4d8\"/>\n  <text x=\"249\" y=\"774\" class=\"bold\" font-size=\"45\" fill=\"#315b50\">有用资源 · 回收利用</text>\n </g>\n <g id=\"resultB\">\n  <rect x=\"1220\" y=\"702\" width=\"516\" height=\"110\" rx=\"12\" fill=\"#ead7c3\"/>\n  <text x=\"1279\" y=\"774\" class=\"bold\" font-size=\"45\" fill=\"#9d5539\">特殊垃圾 · 单独处理</text>\n </g>\n</g>\n</svg>\n<div id=\"sortScene\" class=\"layer\">\n<img id=\"sorting\" data-vfc-video-slot=\"ending_sort\" alt=\"\">\n<div id=\"sortShade\"></div>\n<svg class=\"layer\" viewBox=\"0 0 1920 1080\" xmlns=\"http://www.w3.org/2000/svg\">\n <text x=\"111\" y=\"215\" class=\"bold\" font-size=\"71\" fill=\"#f5f3e9\">垃圾分类，还有用吗？</text>\n <path d=\"M113 241H881\" stroke=\"#e2a164\" stroke-width=\"8\"/>\n <text id=\"answer\" x=\"112\" y=\"333\" class=\"bold\" font-size=\"52\" fill=\"#e9e9db\" opacity=\"0\">仍然有用</text>\n</svg>\n</div>\n</div>\n<script>\nconst t=gsap.timeline({paused:true});\nt.to(\"#answer\",{opacity:1,y:-8,duration:.45},.9)\n .to(\"#sortScene\",{opacity:0,duration:.4},2.0)\n .to(\"#recyclables\",{opacity:1,duration:.4},2.15)\n .from(\"#paper\",{opacity:0,y:28,duration:.45},2.3)\n .from(\"#plastic\",{opacity:0,y:28,duration:.45},2.65)\n .from(\"#metal\",{opacity:0,y:28,duration:.45},3.0)\n .to(\"#recyclables\",{opacity:0,duration:.4},5.1)\n .to(\"#hazard\",{opacity:1,duration:.45},5.3)\n .from(\"#battery\",{opacity:0,y:22,duration:.4},5.45)\n .from(\"#lamp\",{opacity:0,y:22,duration:.4},6.0)\n .from(\"#medicine\",{opacity:0,y:22,duration:.4},6.55)\n .to(\"#hazard\",{opacity:0,duration:.4},9.95)\n .to(\"#food\",{opacity:1,duration:.5},10.1)\n .to(\"#food\",{opacity:0,duration:.5},12.7)\n .to(\"#closing\",{opacity:1,duration:.6},13.0)\n .from(\"#resultA\",{opacity:0,