9-24 39-25z M1513 730l-24-94 24-39 25 39z M1377 594l94-25 39 25-39 24z\" fill=\"#7ca396\"/>\r\n  <path d=\"M1703 491l-48 110h51l-23 100 86-138h-51l36-72Z\" fill=\"#d98742\"/>\r\n  <text x=\"1391\" y=\"817\" class=\"bold\" font-size=\"41\" fill=\"#315250\">利用热量发电</text>\r\n </g>\r\n</g></svg>\r\n<div id=\"landVideo\"><img id=\"landfillFootage\" data-vfc-video-slot=\"landfill_video\" alt=\"\"><div id=\"landShade\"></div><div id=\"landHeadline\">垃圾越来越多</div></div>\r\n</div>\r\n<script>\r\nconst t=gsap.timeline({paused:true});\r\nt.set(\"#chart\",{x:350},0)\r\n .set(\"#landfill\",{x:-590,y:-80},0)\r\n .from(\"#chart\",{opacity:0,y:18,duration:.5},0)\r\n .from(\"#barA\",{scaleY:0,transformOrigin:\"50% 100%\",duration:.9,ease:\"power2.out\"},.3)\r\n .from(\"#labelA\",{opacity:0,y:15,duration:.45},.7)\r\n .from(\"#barB\",{scaleY:0,transformOrigin:\"50% 100%\",duration:.8,ease:\"power2.out\"},3.3)\r\n .from(\"#labelB\",{opacity:0,y:15,duration:.4},3.9)\r\n .to(\"#landVideo\",{opacity:1,duration:.25},5.4)\r\n .to(\"#chart\",{opacity:0,duration:.1},5.65)\r\n .to(\"#landVideo\",{opacity:0,duration:.4},6.2)\r\n .to(\"#landfill\",{opacity:1,duration:.4},6.2)\r\n .to(\"#leachate\",{opacity:1,duration:.7},10.05)\r\n .to(\"#landfill\",{opacity:0,duration:.5},13.2)\r\n .to(\"#energy\",{opacity:1,duration:.6},13.45)\r\n .from(\"#energyFurnace\",{opacity:0,y:25,duration:.5},13.7)\r\n .from(\"#energyPower\",{opacity:0,x:25,duration:.7},15.3)\r\n .to(\"#turbineBlades\",{rotation:90,transformOrigin:\"50% 50%\",duration:3.3,ease:\"none\"},15.4)\r\n .to({},{duration:3.32},16.0);\r\nwindow.__timelines=window.__timelines||{};window.__timelines[\"garbage-growth\"]=t;\r\nwindow.getVfcMotionEvents=()=>[\r\n {id:\"growth\",meaning:\"垃圾清运量增长比较\",startFrame:0,endFrame:135},\r\n {id:\"waste_scale\",meaning:\"垃圾堆积的规模\",startFrame:135,endFrame:165},\r\n {id:\"landfill\",meaning:\"填埋占地与渗滤液\",startFrame:165,endFrame:337},\r\n {id:\"energy\",meaning:\"焚烧减容并利用热量发电\",startFrame:337,endFrame:482}\r\n];\r\n