    "source": "<!doctype html>\r\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><style>\r\n*{box-sizing:border-box} html,body{padding:0;margin:0;overflow:hidden} \r\n#film{position:relative;width:1920px;height:1080px;background:#e9e7df;color:#193636;font-family:var(--vfc-font-main),sans-serif}\r\nsvg{display:block;width:1920px;height:1080px}.sans{font-family:var(--vfc-font-main),sans-serif}.bold{font-family:var(--vfc-font-bold),sans-serif}\r\n#landVideo{position:absolute;inset:0;opacity:0;overflow:hidden;background:#263d3a}\r\n#landVideo img{display:block;width:100%;height:100%;object-fit:cover}\r\n#landShade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(18,39,37,.78),rgba(18,39,37,.06) 75%),linear-gradient(0deg,rgba(18,39,37,.55),transparent 24%)}\r\n#landHeadline{position:absolute;left:110px;top:150px;color:#f4f3e9;font-family:var(--vfc-font-bold),sans-serif;font-size:67px}\r\n</style></head><body>\r\n<div id=\"film\" data-composition-id=\"garbage-growth\" data-start=\"0\" data-width=\"1920\" data-height=\"1080\" data-duration=\"19.32\">\r\n<svg viewBox=\"0 0 1920 1080\" xmlns=\"http://www.w3.org/2000/svg\">\r\n<defs><pattern id=\"grid\" width=\"54\" height=\"54\" patternUnits=\"userSpaceOnUse\"><path d=\"M54 0H0V54\" fill=\"none\" stroke=\"#879b96\" stroke-opacity=\".16\" stroke-width=\"2\"/></pattern>\r\n<linearGradient id=\"land\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop stop-color=\"#999172\"/><stop offset=\"1\" stop-color=\"#635e4e\"/></linearGradient></defs>\r\n<rect width=\"1920\" height=\"1080\" fill=\"#e9e7df\"/><rect width=\"1920\" height=\"1080\" fill=\"url(#grid)\"/>\r\n<path d=\"M0 98H1920\" stroke=\"#91a49d\" stroke-width=\"2\" opacity=\".6\"/>\r\n<text x=\"86\" y=\"67\" class=\"sans\" font-size=\"27\" letter-spacing=\"4\" fill=\"#344e4e\">垃圾的去向</text>\r\n<g id=\"chart\">\r\n <text x=\"125\" y=\"220\" class=\"bold\" font-size=\"67\" fill=\"#193636\">城市生活垃圾清运量</text>\r\n <path d=\"M128 765H1004\" stroke=\"#69817b\" stroke-width=\"5\"/>\r\n <path d=\"M128 765V264\" stroke=\"#a9b7aa\" stroke-width=\"3\"/>\r\n <text x=\"88\" y=\"775\" class=\"sans\" font-size=\"27\" fill=\"#607b75\">0</text>\r\n <g id=\"barA\"><rect x=\"284\" y=\"515\" width=\"210\" height=\"250\" rx=\"5\" fill=\"#809f94\"/><path d=\"M284 515H494\" stroke=\"#577d73\" stroke-width=\"9\"/></g>\r\n <g id=\"barB\"><rect x=\"646\" y=\"265\" width=\"210\" height=\"500\" rx=\"5\" fill=\"#315b59\"/><path d=\"M646 265H856\" stroke=\"#193f3f\" stroke-width=\"9\"/></g>\r\n <g id=\"labelA\" fill=\"#315b59\"><text x=\"275\" y=\"478\" class=\"bold\" font-size=\"55\">1.2 亿吨</text><text x=\"323\" y=\"825\" class=\"sans\" font-size=\"33\">2000 年</text></g>\r\n <g id=\"labelB\" fill=\"#244d4b\"><text x=\"665\" y=\"330\" class=\"bold\" font-size=\"47\" fill=\"#f3f1e8\">2.4 亿吨</text><text x=\"685\" y=\"825\" class=\"sans\" font-size=\"33\">2019 年</text></g>\r\n</g>\r\n<g id=\"landfill\" opacity=\"0\">\r\n <path d=\"M1073 688L1122 649 1166 662 1216 601 1270 614 1312 572 1372 591 1431 533 1493 554 1547 518 1622 563 1676 548 1730 604 1808 617 1854 670 1854 762H1073Z\" fill=\"url(#land)\"/>\r\n <path d=\"M1073 727L1139 705 1190 718 1254 673 1301 685 1359 647 1413 664 1487 623 1542 643 1598 611 1672 646 1740 643 1813 685 1854 683V762H1073Z\" fill=\"#5d6253\"/>\r\n <path d=\"M1163 678l29-16 27 9-4 17-37 1z M1265 642l32-14 26 10-5 20-38 1z M1398 610l28-18 25 9-3 22-38-2z M1548 584l27-11 26 12-5 15-33 1z M1694 645l29-14 25 9-5 17-35 1z\" fill=\"#c0b699\"/>\r\n <path d=\"M1074 762H1854V813H1074Z\" fill=\"#596a5e\"/>\r\n <path d=\"M1074 813H1854V908H1074Z\" fill=\"#c7bd9f\"/>\r\n <path d=\"M1074 908H1854\" stroke=\"#83b8b8\" stroke-width=\"14\"/>\r\n <text x=\"1080\" y=\"476\" class=\"bold\" font-size=\"53\" fill=\"#334f4e\">填埋场占地</text>\r\n <g id=\"leachate\" opacity=\"0\">\r\n   <path d=\"M1355 744c0-14 14-30 14-30s14 16 14 30a14 14 0 1 1-28 0z M1486 724c0-14 14-30 14-30s14 16 14 30a14 14 0 1 1-28 0z M1593 748c0-14 14-30 14-30s14 16 14 30a14 14 0 1 1-2